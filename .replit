modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
VK_CLIENT_ID = "54759657"
VK_REDIRECT_URI = "https://170e6e26-e061-48ec-bffa-bbc5d366fbe7-00-aqe4dpap1lbr.kirk.replit.dev/api/auth/vk"
